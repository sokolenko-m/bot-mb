# Notion — та же интеграция и база "Задачи", что использует notion_scheduler
NOTION_TOKEN=ntn_...
NOTION_DATA_SOURCE_ID=3b17a095-971a-8012-94b1-000b05b11d55

# Telegram-бот (токен от @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC...

# Доступ даётся в Notion: «Участники_1» → Telegram ID + галочка «Доступ до звітів».
# Здесь — запасной доступ администратора (Telegram user id через запятую), работает даже без Notion.
ALLOWED_USER_IDS=536041034

# Необязательно (значения по умолчанию уже в коде):
# NOTION_PARTICIPANTS_DS_ID=37d7a095-971a-8076-8dfd-000bf72aec67
# NOTION_HEARTBEAT_PAGE_ID=3f47a095-971a-8176-bc9f-e6bc48bdc767

# На Render PORT подставляется автоматически, локально можно не задавать (по умолчанию 3000)
PORT=3000
